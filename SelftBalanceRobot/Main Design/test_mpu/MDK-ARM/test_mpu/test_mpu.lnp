".\test_mpu\stm32f1xx_hal_i2c.o"
".\test_mpu\stm32f1xx_hal.o"
".\test_mpu\stm32f1xx_hal_rcc.o"
".\test_mpu\stm32f1xx_hal_rcc_ex.o"
".\test_mpu\stm32f1xx_hal_gpio.o"
".\test_mpu\stm32f1xx_hal_dma.o"
".\test_mpu\stm32f1xx_hal_cortex.o"
".\test_mpu\stm32f1xx_hal_pwr.o"
