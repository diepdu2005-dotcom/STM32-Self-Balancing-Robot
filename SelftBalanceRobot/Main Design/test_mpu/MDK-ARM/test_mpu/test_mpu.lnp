--cpu Cortex-M3
".\test_mpu\startup_stm32f103xb.o"
".\test_mpu\main.o"
".\test_mpu\stm32f1xx_it.o"
".\test_mpu\stm32f1xx_hal_msp.o"
".\test_mpu\mpu6050.o"
